c:PL-001 a owl:NamedIndividual,
        skos:Concept ;
    dcterms:created "2026-10-21"^^xsd:date ;
    dcterms:source "Used throughout all collected policies"@en ;
    skos:altLabel "PII"@en,
        "personal information"@en,
        "personally identifiable information"@en,
        "your information"@en ;
    skos:definition "Data that relates to an identified or identifiable person."@en ;
    skos:exactMatch dpv:PersonalData ;
    skos:inScheme pl:DataTypeScheme ;
    skos:narrower c:PL-002,
        c:PL-005,
        c:PL-006,
        c:PL-007,
        c:PL-008,
        c:PL-024 ;
    skos:notation "PL-001" ;
    skos:prefLabel "Personal data"@en ;
    skos:scopeNote "Includes data a policy calls non-personal or anonymous if this vocabulary classifies it as personal (see CQ14)."@en ;
    pl:mappingStatus "verified" .

pl:DataTypeScheme a skos:ConceptScheme ;
